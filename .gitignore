.DS_Store

# Vendored reference copy of the Tolaria OSS repo (architecture reference only)
tolaria-main/

# App build artifacts
node_modules/
dist/
# Signed .app + DMG produced by scripts/mac-package.sh
dist-mac/
.vite/
src-tauri/target/
# Sanitized build-only demo snapshot (build.rs), never the source corpus.
src-tauri/.bundle-resources/
src-tauri/gen/schemas/

# Playwright artifacts
test-results/
playwright-report/
/.playwright-mcp/

# Local verification evidence. Keep maintained plans, specs, implementation
# summaries and test/runner source tracked; raw runs and copied snapshots stay
# on this machine. Links into these directories are local evidence references.
/docs/acceptance/
/docs/superpowers/**/captures/
/docs/superpowers/validation/**/*.log
/docs/superpowers/specs/*-ui-implementation/*-manifest.json
/docs/superpowers/specs/*-ui-implementation/source-before.json
/docs/superpowers/specs/*-ui-implementation/source-after.json
/docs/superpowers/plans/*-store-comparison/*.json
/docs/superpowers/plans/*-store-comparison/*.diff

# Generated quit-smoke bundles; web/index.html and web/smoke.js are source.
/conformance/native-read-smoke/web/quit.js
/conformance/native-read-smoke/web/quit-*.js
/conformance/native-read-smoke/web/quit-*.wasm
/conformance/native-read-smoke/web/quit-build.json

# Python interpreter caches, not maintained Python runners/tests.
__pycache__/
*.py[cod]

docs/examples
docs/archive

# vitest coverage output (M14.4)
coverage/

# Agent worktrees and local scratch in any .claude/ folder stay ignored. The
# root .claude/skills/ is the one tracked corner (M53.23), so the pattern takes
# `/*`: git cannot re-include a file under an excluded folder. The `**/` keeps
# a .claude/ made in a subfolder ignored, as before.
**/.claude/*
!/.claude/skills/

# Superpowers brainstorming scratch (mockups, server state)
.superpowers/
docs/cerebro
docs/cerebro-ds

# The app's architecture needs no secrets today — the assistant is the user's
# own CLI and no API key ever enters the app. This is for the first day that
# stops being true, so it is here BEFORE there is anything to leak (M32.7).
.env
.env.*

# The design-system build output (M100.1): regenerated by `pnpm ds:build`.
design-system/out/
