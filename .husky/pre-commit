# Fast lane (M14.5): seconds, not minutes. Lint only — the full gate runs on
# push. Skips entirely when nothing lintable is staged (docs, vault fixtures).
#
# Policy: never bypass with --no-verify. If the hook is wrong, fix the hook.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
case "$staged" in
  *.ts* | *.js* | *.tsx* | *.jsx* | *.mjs* | *.cjs*) ;;
  *) exit 0 ;;
esac

pnpm lint
