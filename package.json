    "@dnd-kit/core": "^6.3.1",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^0.525.0",
    "mermaid": "^11.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "yaml": "^2.8.0",
    "zustand": "^5.0.6"
