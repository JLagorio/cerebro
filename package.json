    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@blocknote/code-block": "0.46.2",
    "@blocknote/core": "0.46.2",
    "@blocknote/mantine": "0.46.2",
