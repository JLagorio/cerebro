{
  "version": 1,
  "canonicalCases": [
    {
      "name": "canonical_input_distinguishes_null_omission_and_array_order",
      "source": "{\"b\":[2,1],\"a\":null}",
      "canonical": "{\"a\":null,\"b\":[2,1]}"
    },
    {
      "name": "omitted",
      "source": "{\"b\":[2,1]}",
      "canonical": "{\"b\":[2,1]}"
    },
    {
      "name": "array_order",
      "source": "{\"b\":[1,2],\"a\":null}",
      "canonical": "{\"a\":null,\"b\":[1,2]}"
    },
    {
      "name": "numeric_forms",
      "source": "[1,1.0,1e0,-0,0.10,1000]",
      "canonical": "[1,1,1,0,1e-1,1e3]"
    },
    {
      "name": "exact_precision",
      "source": "[9007199254740993,1.0000000000000001]",
      "canonical": "[9007199254740993,10000000000000001e-16]"
    },
    {
      "name": "unicode_not_normalized",
      "source": "{\"é\":\"é\",\"a\":\"\\u00e9\"}",
      "canonical": "{\"a\":\"é\",\"é\":\"é\"}"
    }
  ],
