{
  "format": 1,
  "artifact_version": 2,
  "rule_version": "dates/2026-10-15",
  "forms": ["date", "date_time", "instant"],
  "time_separators": [" ", "T"],
  "written_separator": " ",
  "date_time": {"seconds": "never"},
  "instant": {"seconds": "optional", "fraction_digits": {"min": 1, "max": 9}, "zones": ["Z", "+HH:MM", "-HH:MM"]},
  "calendar": "proleptic_gregorian",
  "read": "lenient",
  "write": "strict",
  "backwards": "same_form",
  "relative": {
    "days": [
      {"token": "today", "offset": 0, "words": "today"},
      {"token": "tomorrow", "offset": 1, "words": "tomorrow"},
      {"token": "yesterday", "offset": -1, "words": "yesterday"}
    ],
    "offsets": {"prefix": "today", "signs": {"+": 1, "-": -1}, "min": 1, "max": 999, "leading_zero": false},
    "periods": [
      {"token": "this_week", "unit": "week", "offset": 0, "words": "this week"},
      {"token": "last_week", "unit": "week", "offset": -1, "words": "last week"},
      {"token": "next_week", "unit": "week", "offset": 1, "words": "next week"},
      {"token": "this_month", "unit": "month", "offset": 0, "words": "this month"},
      {"token": "last_month", "unit": "month", "offset": -1, "words": "last month"},
      {"token": "next_month", "unit": "month", "offset": 1, "words": "next month"}
    ],
    "week_starts": [0, 1],
    "words": {"past_one": "{n} day ago", "past_many": "{n} days ago", "future_one": "{n} day from now", "future_many": "{n} days from now"}
  },
  "relative_cases": [
    {"name": "today", "input": "today", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-28", "2026-07-28"]},
    {"name": "tomorrow", "input": "tomorrow", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-29", "2026-07-29"]},
    {"name": "yesterday", "input": "yesterday", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-27", "2026-07-27"]},
    {"name": "seven days ago", "input": "today-7", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-21", "2026-07-21"]},
    {"name": "seven days from now", "input": "today+7", "today": "2026-07-28", "week_start": 0, "expect": ["2026-08-04", "2026-08-04"]},
    {"name": "this Sunday week", "input": "this_week", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-26", "2026-08-01"]},
    {"name": "this Monday week", "input": "this_week", "today": "2026-07-28", "week_start": 1, "expect": ["2026-07-27", "2026-08-02"]},
    {"name": "Sunday starts its week", "input": "this_week", "today": "2026-07-26", "week_start": 0, "expect": ["2026-07-26", "2026-08-01"]},
    {"name": "Sunday ends the Monday week", "input": "this_week", "today": "2026-07-26", "week_start": 1, "expect": ["2026-07-20", "2026-07-26"]},
    {"name": "last week", "input": "last_week", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-19", "2026-07-25"]},
    {"name": "next week", "input": "next_week", "today": "2026-07-28", "week_start": 0, "expect": ["2026-08-02", "2026-08-08"]},
    {"name": "week crosses a year", "input": "this_week", "today": "2027-01-01", "week_start": 1, "expect": ["2026-12-28", "2027-01-03"]},
    {"name": "this month", "input": "this_month", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-01", "2026-07-31"]},
    {"name": "last month", "input": "last_month", "today": "2026-07-28", "week_start": 0, "expect": ["2026-06-01", "2026-06-30"]},
    {"name": "January 31 next month", "input": "next_month", "today": "2026-01-31", "week_start": 0, "expect": ["2026-02-01", "2026-02-28"]},
    {"name": "February in a leap year", "input": "next_month", "today": "2028-01-31", "week_start": 0, "expect": ["2028-02-01", "2028-02-29"]},
    {"name": "last month crosses a year", "input": "last_month", "today": "2027-01-31", "week_start": 0, "expect": ["2026-12-01", "2026-12-31"]},
    {"name": "next month crosses a year", "input": "next_month", "today": "2026-12-31", "week_start": 0, "expect": ["2027-01-01", "2027-01-31"]},
    {"name": "reads trim", "input": " today-1 ", "today": "2026-07-28", "week_start": 0, "expect": ["2026-07-27", "2026-07-27"]},
    {"name": "case must match", "input": "Today", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no zero offset", "input": "today+0", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no leading zero", "input": "today-07", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no offset above 999", "input": "today+1000", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no fractional offset", "input": "today+1.5", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no inner spaces", "input": "today +7", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no extra sign", "input": "today--7", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no prose token", "input": "this week", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no unsupported period", "input": "this_year", "today": "2026-07-28", "week_start": 0, "expect": null},
    {"name": "no unsupported week start", "input": "this_week", "today": "2026-07-28", "week_start": 2, "expect": null},
    {"name": "no year beyond the date grammar", "input": "tomorrow", "today": "9999-12-31", "week_start": 0, "expect": null},
    {"name": "no negative year", "input": "yesterday", "today": "0000-01-01", "week_start": 0, "expect": null}
  ],
  "cases": [
    {"name": "a date", "input": "2026-07-28", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": null, "instant": false}, "end": null}},
    {"name": "a date and a time after a space", "input": "2026-07-28 14:30", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "14:30", "instant": false}, "end": null}},
    {"name": "a date and a time after a T", "input": "2026-07-28T14:30", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "14:30", "instant": false}, "end": null}},
    {"name": "a floating time ignores the zone", "input": "2026-07-28 23:30", "zone": "Australia/Sydney", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "23:30", "instant": false}, "end": null}},
    {"name": "an instant in UTC (phx-421 fetched_at)", "input": "2026-07-28T09:20:00Z", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "09:20", "instant": true}, "end": null}},
    {"name": "an instant in Los Angeles", "input": "2026-07-28T09:20:00Z", "zone": "America/Los_Angeles", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "02:20", "instant": true}, "end": null}},
    {"name": "an instant in Sydney", "input": "2026-07-28T09:20:00Z", "zone": "Australia/Sydney", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "19:20", "instant": true}, "end": null}},
    {"name": "an instant at +05:30", "input": "2026-07-28T09:20:00+05:30", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "03:50", "instant": true}, "end": null}},
    {"name": "an instant at -05:00 lands on the next UTC day", "input": "2026-07-28T22:00:00-05:00", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-29", "time": "03:00", "instant": true}, "end": null}},
    {"name": "the scanner's stamp lands on the previous day in Los Angeles", "input": "2026-07-28T00:00:00Z", "zone": "America/Los_Angeles", "valid": true, "read": {"start": {"date": "2026-07-27", "time": "17:00", "instant": true}, "end": null}},
    {"name": "the mock's stamp, milliseconds and all", "input": "2026-07-28T09:20:00.000Z", "zone": "Australia/Sydney", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "19:20", "instant": true}, "end": null}},
    {"name": "nine fraction digits at +00:00", "input": "2026-07-28T09:20:00.123456789+00:00", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "09:20", "instant": true}, "end": null}},
    {"name": "an instant without seconds", "input": "2026-07-28T09:20Z", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "09:20", "instant": true}, "end": null}},
    {"name": "an instant after a space", "input": "2026-07-28 09:20:00Z", "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "09:20", "instant": true}, "end": null}},
    {"name": "the US DST start day, a minute before the jump", "input": "2026-03-08T09:59:00Z", "zone": "America/Los_Angeles", "valid": true, "read": {"start": {"date": "2026-03-08", "time": "01:59", "instant": true}, "end": null}},
    {"name": "the US DST start day, after the jump", "input": "2026-03-08T10:30:00Z", "zone": "America/Los_Angeles", "valid": true, "read": {"start": {"date": "2026-03-08", "time": "03:30", "instant": true}, "end": null}},
    {"name": "the US DST end day, the first 01:30", "input": "2026-11-01T08:30:00Z", "zone": "America/Los_Angeles", "valid": true, "read": {"start": {"date": "2026-11-01", "time": "01:30", "instant": true}, "end": null}},
    {"name": "the US DST end day, the second 01:30", "input": "2026-11-01T09:30:00Z", "zone": "America/Los_Angeles", "valid": true, "read": {"start": {"date": "2026-11-01", "time": "01:30", "instant": true}, "end": null}},
    {"name": "a leap day", "input": "2024-02-29", "zone": "UTC", "valid": true, "read": {"start": {"date": "2024-02-29", "time": null, "instant": false}, "end": null}},
    {"name": "no leap day in 2026", "input": "2026-02-29", "zone": "UTC", "valid": false, "read": null},
    {"name": "no February 30th", "input": "2026-02-30", "zone": "UTC", "valid": false, "read": null},
    {"name": "no thirteenth month", "input": "2026-13-01", "zone": "UTC", "valid": false, "read": null},
    {"name": "no day zero", "input": "2026-07-00", "zone": "UTC", "valid": false, "read": null},
    {"name": "no hour 24", "input": "2026-07-28 24:00", "zone": "UTC", "valid": false, "read": null},
    {"name": "no minute 60", "input": "2026-07-28T09:60Z", "zone": "UTC", "valid": false, "read": null},
    {"name": "an hour needs two digits", "input": "2026-07-28 9:20", "zone": "UTC", "valid": false, "read": null},
    {"name": "a month needs two digits", "input": "2026-7-28", "zone": "UTC", "valid": false, "read": null},
    {"name": "seconds without a zone", "input": "2026-07-28T09:20:00", "zone": "UTC", "valid": false, "read": null},
    {"name": "a lowercase t", "input": "2026-07-28t09:20:00Z", "zone": "UTC", "valid": false, "read": null},
    {"name": "a lowercase z", "input": "2026-07-28T09:20:00z", "zone": "UTC", "valid": false, "read": null},
    {"name": "an offset without its colon", "input": "2026-07-28T09:20:00+0530", "zone": "UTC", "valid": false, "read": null},
    {"name": "a fraction with no digits", "input": "2026-07-28T09:20:00.Z", "zone": "UTC", "valid": false, "read": null},
    {"name": "ten fraction digits", "input": "2026-07-28T09:20:00.1234567890Z", "zone": "UTC", "valid": false, "read": null},
    {"name": "a fraction without seconds", "input": "2026-07-28T09:20.5Z", "zone": "UTC", "valid": false, "read": null},
    {"name": "a date followed by prose", "input": "2026-07-28 kickoff", "zone": "UTC", "valid": false, "read": null},
    {"name": "a template placeholder", "input": "{{date}}", "zone": "UTC", "valid": false, "read": null},
    {"name": "the empty string", "input": "", "zone": "UTC", "valid": false, "read": null},
    {"name": "a number", "input": 20260728, "zone": "UTC", "valid": false, "read": null},
    {"name": "an array", "input": ["2026-07-28"], "zone": "UTC", "valid": false, "read": null},
    {"name": "padding reads but does not write", "input": " 2026-07-28 ", "zone": "UTC", "valid": false, "read": {"start": {"date": "2026-07-28", "time": null, "instant": false}, "end": null}},
    {"name": "a full range", "input": {"start": "2026-07-28", "end": "2026-08-02"}, "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": null, "instant": false}, "end": {"date": "2026-08-02", "time": null, "instant": false}}},
    {"name": "a range whose end is null", "input": {"start": "2026-07-28", "end": null}, "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": null, "instant": false}, "end": null}},
    {"name": "a range with no end", "input": {"start": "2026-07-28"}, "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": null, "instant": false}, "end": null}},
    {"name": "a backwards range reads as written", "input": {"start": "2026-08-02", "end": "2026-07-28"}, "zone": "UTC", "valid": false, "read": {"start": {"date": "2026-08-02", "time": null, "instant": false}, "end": {"date": "2026-07-28", "time": null, "instant": false}}},
    {"name": "a same-day range whose times run backwards", "input": {"start": "2026-07-28 14:00", "end": "2026-07-28 09:00"}, "zone": "UTC", "valid": false, "read": {"start": {"date": "2026-07-28", "time": "14:00", "instant": false}, "end": {"date": "2026-07-28", "time": "09:00", "instant": false}}},
    {"name": "a day then a time on that day compares by day", "input": {"start": "2026-07-28", "end": "2026-07-28 09:00"}, "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-28", "time": null, "instant": false}, "end": {"date": "2026-07-28", "time": "09:00", "instant": false}}},
    {"name": "two instants compare as moments", "input": {"start": "2026-07-28T10:00:00Z", "end": "2026-07-28T12:00:00+05:00"}, "zone": "UTC", "valid": false, "read": {"start": {"date": "2026-07-28", "time": "10:00", "instant": true}, "end": {"date": "2026-07-28", "time": "07:00", "instant": true}}},
    {"name": "an instant and a floating day are not compared", "input": {"start": "2026-07-29", "end": "2026-07-28T09:20:00Z"}, "zone": "UTC", "valid": true, "read": {"start": {"date": "2026-07-29", "time": null, "instant": false}, "end": {"date": "2026-07-28", "time": "09:20", "instant": true}}},
    {"name": "a junk end reads as an open range", "input": {"start": "2026-07-28", "end": "soon"}, "zone": "UTC", "valid": false, "read": {"start": {"date": "2026-07-28", "time": null, "instant": false}, "end": null}},
    {"name": "an end with no start", "input": {"end": "2026-07-28"}, "zone": "UTC", "valid": false, "read": null},
    {"name": "an end with a null start", "input": {"start": null, "end": "2026-07-28"}, "zone": "UTC", "valid": false, "read": null},
    {"name": "an empty mapping", "input": {}, "zone": "UTC", "valid": true, "read": null},
    {"name": "a mapping of nulls", "input": {"start": null, "end": null}, "zone": "UTC", "valid": true, "read": null},
    {"name": "instants across midnight in Sydney", "input": {"start": "2026-07-28T13:00:00Z", "end": "2026-07-28T15:00:00Z"}, "zone": "Australia/Sydney", "valid": true, "read": {"start": {"date": "2026-07-28", "time": "23:00", "instant": true}, "end": {"date": "2026-07-29", "time": "01:00", "instant": true}}}
  ]
}
