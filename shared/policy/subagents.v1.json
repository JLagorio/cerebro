{
  "format": 1,
  "cli_version": "2.1.250",
  "env": {
    "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS": "1",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "2",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "8",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "seated_env": {
    "CLAUDE_CODE_ENABLE_TASKS": "0",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "presets": [
    {
      "name": "cerebro-researcher",
      "description": "Researches a question in the vault, and on the web where this conversation allows it, then reports back what it found without changing anything.",
      "toolsets": [
        "read"
      ],
      "web_when_held": [
        "WebSearch",
        "WebFetch"
      ]
    }
  ],
  "settings": {
    "permissions": {
      "disableBypassPermissionsMode": "disable"
    },
    "disableAutoMode": "disable"
  }
}
