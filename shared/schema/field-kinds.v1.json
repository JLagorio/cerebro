{
  "format": 1,
  "artifact_version": 7,
  "rule_version": "field-kinds/2026-10-15",
  "dates": "shared/calendar/dates.v1.json",
  "atoms": ["string", "number", "boolean", "string_list", "date_text", "date_range", "url_text"],
  "url_prefixes": ["http://", "https://", "mailto:", "www."],
  "url_match": "prefix_ignoring_ascii_case",
  "kinds": [
    {"kind": "text", "accepts": ["string", "number"], "multi": false, "computed": false, "links": false, "groupable": false, "orderable": true, "numeric": false, "media": false, "filters": "text", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be text"}},
    {"kind": "number", "accepts": ["number"], "multi": false, "computed": false, "links": false, "groupable": false, "orderable": true, "numeric": true, "media": false, "filters": "number", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be a number"}},
    {"kind": "checkbox", "accepts": ["boolean"], "multi": false, "computed": false, "links": false, "groupable": true, "orderable": true, "numeric": false, "media": false, "filters": "boolean", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be on or off"}},
