  "filter_ops": ["equals", "not_equals", "contains", "does_not_contain", "starts_with", "ends_with", "any_of", "none_of", "gt", "gte", "lt", "lte", "before", "after", "on_or_before", "on_or_after", "is_between", "is_empty", "is_not_empty"],
  "filter_families": {
    "text": ["contains", "does_not_contain", "equals", "not_equals", "starts_with", "ends_with", "is_empty", "is_not_empty"],
    "number": ["equals", "not_equals", "gt", "gte", "lt", "lte", "is_between", "is_empty", "is_not_empty"],
    "date": ["equals", "before", "after", "on_or_before", "on_or_after", "is_between", "is_empty", "is_not_empty"],
    "choice": ["equals", "not_equals", "any_of", "none_of", "is_empty", "is_not_empty"],
    "multi": ["contains", "does_not_contain", "any_of", "none_of", "is_empty", "is_not_empty"],
    "boolean": ["equals", "not_equals", "is_empty", "is_not_empty"],
    "any": ["equals", "not_equals", "contains", "does_not_contain", "starts_with", "ends_with", "any_of", "none_of", "gt", "gte", "lt", "lte", "before", "after", "on_or_before", "on_or_after", "is_between", "is_empty", "is_not_empty"]
  },
  "status_groups": ["active", "done", "closed"],
  "status_group_default": "active",
  "status_chain": ["project", "type", "default"],
  "default_statuses": [
    {"id": "backlog", "label": "Backlog", "color": "#A8AFC2", "group": "active", "hollow": false},
    {"id": "todo", "label": "Todo", "color": "#3D8BE8", "group": "active", "hollow": false},
    {"id": "in-progress", "label": "In progress", "color": "#EFB428", "group": "active", "hollow": false},
    {"id": "done", "label": "Done", "color": "#34B764", "group": "done", "hollow": false},
    {"id": "cancelled", "label": "Cancelled", "color": "#A8AFC2", "group": "closed", "hollow": true}
  ],
  "rollup_calcs": [
    {"calc": "count", "result": "number"},
    {"calc": "sum", "result": "number"},
    {"calc": "avg", "result": "number"},
    {"calc": "min", "result": "number"},
    {"calc": "max", "result": "number"},
    {"calc": "percent_done", "result": "number"},
    {"calc": "earliest", "result": "value"},
    {"calc": "latest", "result": "value"},
    {"calc": "show", "result": "text"}
  ],
  "virtual_fields": ["title", "type", "createdAt", "modifiedAt"],
  "collation": {"text_tests": "lowercase", "equality": "exact", "ordered": "number_date_code_unit", "sort": "options_number_locale"},
  "deadline_cases": [
    {"name": "a declared date", "fields": {"due": {"kind": "date"}}, "deadline": "due", "expect": "due"},
    {"name": "a declared date range", "fields": {"window": {"kind": "daterange"}}, "deadline": "window", "expect": "window"},
    {"name": "a select is not a deadline", "fields": {"due": {"kind": "select"}}, "deadline": "due", "expect": null},
    {"name": "a computed timestamp is not a deadline", "fields": {"made": {"kind": "created_time"}}, "deadline": "made", "expect": null},
    {"name": "an undeclared field is not a deadline", "fields": {"due": {"kind": "date"}}, "deadline": "other", "expect": null},
    {"name": "the field name is case sensitive", "fields": {"due": {"kind": "date"}}, "deadline": "Due", "expect": null},
    {"name": "the name is trimmed", "fields": {"due": {"kind": "date"}}, "deadline": " due ", "expect": "due"},
    {"name": "a number is not a field name", "fields": {"due": {"kind": "date"}}, "deadline": 7, "expect": null},
    {"name": "a list is not a field name", "fields": {"due": {"kind": "date"}}, "deadline": ["due"], "expect": null},
    {"name": "no deadline is declared", "fields": {"due": {"kind": "date"}}, "deadline": null, "expect": null}
  ],
