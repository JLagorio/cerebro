    {"kind": "select", "accepts": ["string"], "multi": false, "computed": false, "links": false, "groupable": true, "orderable": true, "numeric": false, "media": false, "filters": "choice", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be a single option"}},
    {"kind": "multiselect", "accepts": ["string", "string_list"], "multi": true, "computed": false, "links": false, "groupable": true, "orderable": false, "numeric": false, "media": false, "filters": "multi", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be a list of options"}},
    {"kind": "status", "accepts": ["string"], "multi": false, "computed": false, "links": false, "groupable": true, "orderable": true, "numeric": false, "media": false, "filters": "choice", "status_set": true, "legacy": false, "messages": {"shape": "{name} must be a single option"}},
    {"kind": "person", "accepts": ["string", "string_list"], "multi": true, "computed": false, "links": true, "groupable": true, "orderable": false, "numeric": false, "media": false, "filters": "multi", "status_set": false, "legacy": false, "messages": {"shape": "{name} must reference other pages", "limit_one": "{name} names a single person", "derived": "{name} is the other side of a relation \u2014 edit it from the linked records"}},
    {"kind": "relation", "accepts": ["string", "string_list"], "multi": true, "computed": false, "links": true, "groupable": true, "orderable": false, "numeric": false, "media": false, "filters": "multi", "status_set": false, "legacy": false, "messages": {"shape": "{name} must reference other pages", "limit_one": "{name} links a single record", "derived": "{name} is the other side of a relation \u2014 edit it from the linked records"}},
    {"kind": "url", "accepts": ["url_text"], "multi": false, "computed": false, "links": false, "groupable": false, "orderable": true, "numeric": false, "media": false, "filters": "text", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be a URL (https://\u2026)"}},
    {"kind": "email", "accepts": ["string"], "multi": false, "computed": false, "links": false, "groupable": false, "orderable": true, "numeric": false, "media": false, "filters": "text", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be text"}},
    {"kind": "phone", "accepts": ["string"], "multi": false, "computed": false, "links": false, "groupable": false, "orderable": true, "numeric": false, "media": false, "filters": "text", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be text"}},
    {"kind": "files", "accepts": ["string", "string_list"], "multi": true, "computed": false, "links": false, "groupable": false, "orderable": false, "numeric": false, "media": true, "filters": "multi", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be a list of files"}},
    {"kind": "rollup", "accepts": [], "multi": false, "computed": true, "links": false, "groupable": false, "orderable": true, "numeric": true, "media": false, "filters": "any", "status_set": false, "legacy": false, "messages": {"shape": "{name} is computed and can't be edited"}},
    {"kind": "created_time", "accepts": [], "multi": false, "computed": true, "links": false, "groupable": true, "orderable": true, "numeric": false, "media": false, "filters": "date", "status_set": false, "legacy": false, "messages": {"shape": "{name} is computed and can't be edited"}},
    {"kind": "last_edited_time", "accepts": [], "multi": false, "computed": true, "links": false, "groupable": true, "orderable": true, "numeric": false, "media": false, "filters": "date", "status_set": false, "legacy": false, "messages": {"shape": "{name} is computed and can't be edited"}},
    {"kind": "formula", "accepts": [], "multi": false, "computed": true, "links": false, "groupable": false, "orderable": true, "numeric": true, "media": false, "filters": "any", "status_set": false, "legacy": false, "messages": {"shape": "{name} is computed and can't be edited"}},
    {"kind": "repeat", "accepts": ["string"], "multi": false, "computed": false, "links": false, "groupable": false, "orderable": true, "numeric": false, "media": false, "filters": "text", "status_set": false, "legacy": false, "messages": {"shape": "{name} must be a repeat rule"}}
