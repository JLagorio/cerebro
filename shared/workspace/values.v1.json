{
  "version": 1,
  "decimal": {
    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
    "maxLexemeBytes": 256,
    "legacyMaxSafeInteger": "9007199254740991"
  },
  "limits": {
    "maxSourceBytes": 65536,
    "maxDepth": 32,
    "maxNodes": 4096
  },
  "dates": {
    "grammar": "shared/calendar/dates.v1.json",
    "date": "calendar_day_only",
    "instant": "zoned_instant_only",
    "implicitConversion": false
  },
  "decodeCases": [
    {
      "name": "literal string",
      "source": "\"007\"",
      "schema": "plain",
      "expected": {
        "kind": "string",
        "value": "007"
      }
    },
    {
      "name": "explicit null",
      "source": "null",
      "schema": "plain",
      "expected": {
        "kind": "null"
      }
    },
    {
      "name": "boolean",
      "source": "true",
      "schema": "plain",
      "expected": {
        "kind": "boolean",
        "value": true
      }
    },
    {
      "name": "exact large decimal",
      "source": "9007199254740993.125",
      "schema": "plain",
      "expected": {
        "kind": "decimal",
        "value": "9007199254740993.125"
      }
    },
    {
      "name": "huge finite exponent",
      "source": "1e400",
      "schema": "plain",
      "expected": {
        "kind": "decimal",
        "value": "1e400"
      }
    },
    {
      "name": "tiny finite exponent",
      "source": "1e-400",
      "schema": "plain",
      "expected": {
        "kind": "decimal",
        "value": "1e-400"
      }
    },
    {
      "name": "decimal spelling",
      "source": "-0.00E+03",
      "schema": "plain",
      "expected": {
        "kind": "decimal",
        "value": "-0.00E+03"
      }
    },
    {
      "name": "date-like string",
      "source": "\"2026-10-23\"",
      "schema": "plain",
      "expected": {
        "kind": "string",
        "value": "2026-10-23"
      }
    },
    {
      "name": "schema date",
      "source": "\"2024-02-29\"",
      "schema": "date",
      "expected": {
        "kind": "date",
        "value": "2024-02-29"
      }
    },
    {
      "name": "schema instant",
      "source": "\"2026-10-23T09:00:00.123456789+05:30\"",
      "schema": "instant",
      "expected": {
        "kind": "instant",
        "value": "2026-10-23T09:00:00.123456789+05:30"
      }
    },
    {
      "name": "null date",
      "source": "null",
      "schema": "date",
      "expected": {
        "kind": "null"
      }
    },
    {
      "name": "unknown map",
      "source": "{\"present\":null,\"literal\":\"007\",\"deep\":[9007199254740993.125,true],\"__proto__\":{\"keep\":\"yes\"}}",
      "schema": "plain",
      "expected": {
        "kind": "object",
        "value": {
          "present": {
            "kind": "null"
          },
          "literal": {
            "kind": "string",
            "value": "007"
          },
          "deep": {
            "kind": "array",
            "value": [
              {
                "kind": "decimal",
                "value": "9007199254740993.125"
              },
              {
                "kind": "boolean",
                "value": true
              }
            ]
          },
          "__proto__": {
            "kind": "object",
            "value": {
              "keep": {
                "kind": "string",
                "value": "yes"
              }
            }
          }
        }
      }
    },
    {
      "name": "invalid leap day",
      "source": "\"2026-02-29\"",
      "schema": "date",
      "error": "schema_invalid"
    },
    {
      "name": "date needs schema-compatible form",
      "source": "\"2026-10-23 12:00\"",
      "schema": "date",
      "error": "schema_invalid"
    },
    {
      "name": "instant cannot be day",
      "source": "\"2026-10-23\"",
      "schema": "instant",
      "error": "schema_invalid"
    },
    {
      "name": "date trim refused",
      "source": "\" 2026-10-23 \"",
      "schema": "date",
      "error": "schema_invalid"
    },
    {
      "name": "date numeric refused",
      "source": "20261023",
      "schema": "date",
      "error": "schema_invalid"
    },
    {
      "name": "NaN",
      "source": "NaN",
      "schema": "plain",
      "error": "schema_invalid"
    },
    {
      "name": "infinity",
      "source": "Infinity",
      "schema": "plain",
      "error": "schema_invalid"
    },
    {
      "name": "negative infinity",
      "source": "-Infinity",
      "schema": "plain",
      "error": "schema_invalid"
    },
    {
      "name": "non JSON leading zero",
      "source": "007",
      "schema": "plain",
      "error": "schema_invalid"
    },
    {
      "name": "duplicate key",
      "source": "{\"x\":1,\"x\":2}",
      "schema": "plain",
      "error": "schema_invalid"
    },
    {
      "name": "escaped duplicate key",
      "source": "{\"x\":1,\"\\u0078\":2}",
      "schema": "plain",
      "error": "schema_invalid"
    },
    {
      "name": "unpaired surrogate",
      "source": "\"\\ud800\"",
      "schema": "plain",
      "error": "schema_invalid"
    }
  ],
  "taggedCases": [
    {
      "name": "unresolved relation",
      "value": {
        "kind": "relation",
        "spelling": "[[Unknown#Intro]]",
        "fragment": "Intro",
        "resolution": {
          "status": "unresolved"
        }
      },
      "valid": true
    },
    {
      "name": "ambiguous relation",
      "value": {
        "kind": "relation",
        "spelling": "[[Unknown#Intro]]",
        "fragment": "Intro",
        "resolution": {
          "status": "ambiguous"
        }
      },
      "valid": true
    },
    {
      "name": "carried resolved identity",
      "value": {
        "kind": "relation",
        "spelling": "[[Unknown#Intro]]",
        "fragment": "Intro",
        "resolution": {
          "status": "resolved",
          "targetId": "existing-record-id"
        }
      },
      "valid": true
    },
    {
      "name": "empty resolved identity",
      "value": {
        "kind": "relation",
        "spelling": "[[Unknown#Intro]]",
        "fragment": "Intro",
        "resolution": {
          "status": "resolved",
          "targetId": ""
        }
      },
      "valid": false
    },
    {
      "name": "nonfinite decimal",
      "value": {
        "kind": "decimal",
        "value": "NaN"
      },
      "valid": false
    },
    {
      "name": "infinite decimal",
      "value": {
        "kind": "decimal",
        "value": "Infinity"
      },
      "valid": false
    },
    {
      "name": "padded decimal",
      "value": {
        "kind": "decimal",
        "value": " 1"
      },
      "valid": false
    },
    {
      "name": "decimal as JS number",
      "value": {
        "kind": "decimal",
        "value": 12
      },
      "valid": false
    },
    {
      "name": "invalid tagged date",
      "value": {
        "kind": "date",
        "value": "2026-02-29"
      },
      "valid": false
    },
    {
      "name": "extra field",
      "value": {
        "kind": "null",
        "value": "unexpected"
      },
      "valid": false
    },
    {
      "name": "unresolved extra field",
      "value": {
        "kind": "relation",
        "spelling": "[[Unknown]]",
        "fragment": null,
        "resolution": {
          "status": "unresolved",
          "targetId": "invented"
        }
      },
      "valid": false
    },
    {
      "name": "ambiguous extra field",
      "value": {
        "kind": "relation",
        "spelling": "[[Duplicate]]",
        "fragment": null,
        "resolution": {
          "status": "ambiguous",
          "targetId": "invented"
        }
      },
      "valid": false
    },
    {
      "name": "nested null extra field",
      "value": {
        "kind": "object",
        "value": {
          "x": {
            "kind": "null",
            "lost": 1
          }
        }
      },
      "valid": false
    }
  ],
  "changeCases": [
    {
      "name": "remove is legacy null",
      "changes": [
        {
          "op": "remove",
          "key": "present"
        }
      ],
      "expected": {
        "present": null
      }
    },
    {
      "name": "Set null is not removal",
      "changes": [
        {
          "op": "set",
          "key": "present",
          "value": {
            "kind": "null"
          }
        }
      ],
      "error": "capability_unavailable"
    },
    {
      "name": "string stays string",
      "changes": [
        {
          "op": "set",
          "key": "literal",
          "value": {
            "kind": "string",
            "value": "007"
          }
        }
      ],
      "expected": {
        "literal": "007"
      }
    },
    {
      "name": "safe canonical integer",
      "changes": [
        {
          "op": "set",
          "key": "integer",
          "value": {
            "kind": "decimal",
            "value": "9007199254740991"
          }
        }
      ],
      "expected": {
        "integer": 9007199254740991
      }
    },
    {
      "name": "negative safe integer",
      "changes": [
        {
          "op": "set",
          "key": "integer",
          "value": {
            "kind": "decimal",
            "value": "-9007199254740991"
          }
        }
      ],
      "expected": {
        "integer": -9007199254740991
      }
    },
    {
      "name": "unsafe integer",
      "changes": [
        {
          "op": "set",
          "key": "number",
          "value": {
            "kind": "decimal",
            "value": "9007199254740992"
          }
        }
      ],
      "error": "capability_unavailable"
    },
    {
      "name": "fraction",
      "changes": [
        {
          "op": "set",
          "key": "number",
          "value": {
            "kind": "decimal",
            "value": "0.5"
          }
        }
      ],
      "error": "capability_unavailable"
    },
    {
      "name": "exponent",
      "changes": [
        {
          "op": "set",
          "key": "number",
          "value": {
            "kind": "decimal",
            "value": "1e3"
          }
        }
      ],
      "error": "capability_unavailable"
    },
    {
      "name": "negative zero",
      "changes": [
        {
          "op": "set",
          "key": "number",
          "value": {
            "kind": "decimal",
            "value": "-0"
          }
        }
      ],
      "error": "capability_unavailable"
    },
    {
      "name": "trailing decimals",
      "changes": [
        {
          "op": "set",
          "key": "number",
          "value": {
            "kind": "decimal",
            "value": "12.00"
          }
        }
      ],
      "error": "capability_unavailable"
    },
    {
      "name": "date string",
      "changes": [
        {
          "op": "set",
          "key": "due",
          "value": {
            "kind": "date",
            "value": "2024-02-29"
          }
        }
      ],
      "expected": {
        "due": "2024-02-29"
      }
    },
    {
      "name": "instant string",
      "changes": [
        {
          "op": "set",
          "key": "when",
          "value": {
            "kind": "instant",
            "value": "2026-10-23T09:00Z"
          }
        }
      ],
      "expected": {
        "when": "2026-10-23T09:00Z"
      }
    },
    {
      "name": "relation needs richer store",
      "changes": [
        {
          "op": "set",
          "key": "related",
          "value": {
            "kind": "relation",
            "spelling": "[[Unknown#Intro]]",
            "fragment": "Intro",
            "resolution": {
              "status": "unresolved"
            }
          }
        }
      ],
      "error": "capability_unavailable"
    },
    {
      "name": "nested null remains value",
      "changes": [
        {
          "op": "set",
          "key": "unknown",
          "value": {
            "kind": "object",
            "value": {
              "present": {
                "kind": "null"
              },
              "literal": {
                "kind": "string",
                "value": "007"
              }
            }
          }
        }
      ],
      "expected": {
        "unknown": {
          "present": null,
          "literal": "007"
        }
      }
    },
    {
      "name": "duplicate change key refused",
      "changes": [
        {
          "op": "remove",
          "key": "x"
        },
        {
          "op": "set",
          "key": "x",
          "value": {
            "kind": "boolean",
            "value": true
          }
        }
      ],
      "error": "schema_invalid"
    }
  ],
  "selectedQuery": {
    "version": 1,
    "fieldKinds": "shared/schema/field-kinds.v1.json",
    "taggedScalarKinds": [
      "null",
      "string",
      "boolean",
      "decimal",
      "date",
      "instant"
    ],
    "rawScalarKinds": [
      "string",
      "boolean"
    ],
    "rawNumbers": "canonical_safe_integers_only",
    "rawIntegerLimitRef": "decimal.legacyMaxSafeInteger",
    "arrayOperands": "operator_lists_only",
    "missingEqualsScalar": false,
    "crossKindEquality": "unequal",
    "crossKindOrdering": "unsupported",
    "decimalComparison": "exact_numeric_value",
    "dateStringOperands": "declared_date_family_only",
    "resultValues": "tagged_present_keys_only",
    "emptyValues": [
      "absent",
      "null",
      "empty_string",
      "empty_array"
    ],
    "sortEmpty": "last",
    "sortTie": "record_id",
    "defaultOrder": "path",
    "rawNull": "explicit_null_when_value_key_present",
    "temporalSort": {
      "primary": "shared_calendar_local_date_wall_time",
      "calendarDayTime": "midnight",
      "sameMidnight": "date_before_instant",
      "repeatedWallTime": "absolute_nanosecond",
      "tie": "record_id"
    }
  },
  "selectedQueryCases": [
    {
      "name": "literal 007 never equals numeric seven",
      "operation": "query_records",
      "type": {
        "name": "Record",
        "fields": {}
      },
      "records": [
        {
          "path": "literal.md",
          "properties": {
            "value": {
              "kind": "string",
              "value": "007"
            }
          }
        },
        {
          "path": "numeric.md",
          "properties": {
            "value": {
              "kind": "decimal",
              "value": "7"
            }
          }
        }
      ],
      "args": {
        "type": "Record",
        "fields": [
          "value"
        ],
        "filters": {
          "all": [
            {
              "field": "value",
              "op": "equals",
              "value": {
                "kind": "string",
                "value": "007"
              }
            }
          ]
        }
      },
      "expect": {
        "paths": [
          "literal.md"
