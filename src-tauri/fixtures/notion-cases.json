{
  "format": 1,
  "about": "Synthetic toy envelopes using documented Notion enhanced markdown, not a live recording. Rust normalizes; the editor replays expected markdown. UPDATE_NOTION_CASES=1 cargo test write_notion_cases -- --ignored regenerates expectations; review each changed byte.",
  "cases": [
    {
      "name": "callout and nested columns",
      "page": "11111111111111111111111111111111",
      "capture": "<page url=\"https://www.notion.so/11111111111111111111111111111111\">\n<properties>\n{\"title\": \"Toy page\"}\n</properties>\n<content>\n<callout color=\"yellow_background\">Careful\n\nAnother paragraph</callout>\n<columns><column>Left</column><column><details><summary>Open</summary>Hidden</details></column></columns>\n</content>\n</page>",
      "linkable": {},
      "expect": {
        "markdown": "---\n---\n\n# Toy page\n\n> [!warning]\n> Careful\n\n\n\n:::indent\n\nAnother paragraph\n\n:::\n\n\n\n\n:::columns\n\n::::column\n\nLeft\n\n::::\n\n\n\n::::column\n\n:::::toggle Open\n\nHidden\n\n:::::\n\n::::\n\n:::\n",
        "counts": {
          "linked": 0,
          "media": 0,
          "databases": 0
        }
      }
    },
    {
      "name": "colours",
      "page": "11111111111111111111111111111111",
      "capture": "<page url=\"https://www.notion.so/11111111111111111111111111111111\">\n<properties>\n{\"title\": \"Toy page\"}\n</properties>\n<content>\n<callout color=\"red\">Red</callout>\n<callout color=\"green\">Green</callout>\n<callout color=\"blue\">Blue</callout>\n</content>\n</page>",
      "linkable": {},
      "expect": {
        "markdown": "---\n---\n\n# Toy page\n\n> [!danger]\n> Red\n\n\n\n\n> [!tip]\n> Green\n\n\n\n\n> [!note]\n> Blue\n",
        "counts": {
          "linked": 0,
          "media": 0,
          "databases": 0
