{
  "format": 1,
  "about": "Canonical github.com PR URL boundary shared by Rust argv and TypeScript. No trim, trailing slash, percent, controls, whitespace or backslash. Scheme/host ASCII case-insensitive; path case kept. Hand-shaped, no live reads.",
  "cases": [
    {
      "name": "ordinary",
      "input": "https://github.com/acme/notes/pull/1",
      "expect": {
        "owner": "acme",
        "repo": "notes",
        "number": 1,
        "canonical": "https://github.com/acme/notes/pull/1",
        "key": "https://github.com/acme/notes/pull/1"
      }
    },
    {
      "name": "case-kept",
      "input": "HTTPS://WWW.GITHUB.COM/Acme/Notes/pull/42",
      "expect": {
        "owner": "Acme",
        "repo": "Notes",
        "number": 42,
        "canonical": "https://github.com/Acme/Notes/pull/42",
        "key": "https://github.com/acme/notes/pull/42"
      }
    },
    {
      "name": "suffix-files",
      "input": "https://github.com/acme/notes/pull/12/files?view=split#diff-a",
      "expect": {
        "owner": "acme",
        "repo": "notes",
        "number": 12,
        "canonical": "https://github.com/acme/notes/pull/12",
        "key": "https://github.com/acme/notes/pull/12"
      }
    },
    {
      "name": "suffix-commits",
      "input": "https://github.com/acme/notes/pull/12/commits?view=split#diff-a",
      "expect": {
        "owner": "acme",
        "repo": "notes",
        "number": 12,
        "canonical": "https://github.com/acme/notes/pull/12",
        "key": "https://github.com/acme/notes/pull/12"
      }
    },
    {
      "name": "suffix-checks",
      "input": "https://github.com/acme/notes/pull/12/checks?view=split#diff-a",
      "expect": {
        "owner": "acme",
        "repo": "notes",
        "number": 12,
        "canonical": "https://github.com/acme/notes/pull/12",
        "key": "https://github.com/acme/notes/pull/12"
      }
    },
    {
      "name": "maximum-number",
      "input": "https://github.com/a/x/pull/9999999999",
      "expect": {
        "owner": "a",
        "repo": "x",
        "number": 9999999999,
        "canonical": "https://github.com/a/x/pull/9999999999",
        "key": "https://github.com/a/x/pull/9999999999"
      }
    },
    {
      "name": "punctuation-repo",
      "input": "https://github.com/a-b/a._-b/pull/2",
      "expect": {
        "owner": "a-b",
        "repo": "a._-b",
        "number": 2,
        "canonical": "https://github.com/a-b/a._-b/pull/2",
        "key": "https://github.com/a-b/a._-b/pull/2"
      }
    },
    {
      "name": "query-only",
      "input": "https://github.com/acme/notes/pull/1?",
      "expect": {
        "owner": "acme",
        "repo": "notes",
        "number": 1,
        "canonical": "https://github.com/acme/notes/pull/1",
        "key": "https://github.com/acme/notes/pull/1"
      }
    },
    {
      "name": "http",
      "input": "http://github.com/acme/notes/pull/1",
      "expect": null
    },
    {
