{
  "format": 1,
  "about": "M67.3 upstream structural reference rewriting. Inputs are one based; formula output cells and operation at are zero based. Calculations stay paused. Unchanged before/after formulas retain the source spelling in the UI. M67.3b adds paused autofill and partial-parser completion. Fill areas and targets are zero based; source/target are engine text matrices; completion cursor counts raw Unicode characters, replace_from counts formula-body characters after =.",
  "restructure": [
    {
      "name": "row zero rewrites a sum range",
      "sheets": [
        {
          "name": "Budget",
          "cells": [
            {
              "row": 1,
              "col": 1,
              "source": "1"
            },
            {
              "row": 2,
              "col": 1,
              "source": "2"
            },
            {
              "row": 3,
              "col": 1,
              "source": "3"
            },
            {
              "row": 4,
              "col": 1,
              "source": "=sum(a1:a3)"
            }
          ]
        }
      ],
      "sheet": 0,
      "change": "insert_rows",
      "at": 0,
      "count": 1,
      "expect": {
        "before": [
          {
            "sheet": 0,
            "row": 3,
            "column": 0,
            "source": "=SUM(A1:A3)"
          }
        ],
        "after": [
          {
            "sheet": 0,
            "row": 4,
            "column": 0,
            "source": "=SUM(A2:A4)"
          }
        ]
      }
    },
