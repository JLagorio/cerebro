{
  "about": "M58.1 (CV-33): one row per write door. Each case runs in a fresh vault holding `seed`, calls the door with `args`, and either is refused with a message containing `refused`, or records exactly the row `records` names (null: no row) in vault_writes. IPC rows are stamped human_actor with no run; agent rows are stamped with their `stamp`. Replayed by src-tauri/src/lib.rs (ipc), src-tauri/src/mcp.rs (agent) and src/lib/mockIpc.test.ts (both). A path under /SOURCE/ is a file outside the vault, made by the replay.",
  "human_actor": "human:me",
  "ipc": [
    {
      "door": "save_note",
      "seed": { "door-cases/a.md": "# A\n" },
      "args": { "path": "door-cases/a.md", "body": "# A\n\nSaved.\n" },
      "records": { "kind": "vault.write", "path": "door-cases/a.md" }
    },
    {
      "door": "save_note",
      "seed": { "door-cases/flow.mmd": "flowchart TD\n" },
      "args": { "path": "door-cases/flow.mmd", "body": "graph LR\n" },
      "records": { "kind": "vault.write", "path": "door-cases/flow.mmd" }
    },
    {
      "door": "update_frontmatter",
      "seed": { "door-cases/a.md": "---\nstatus: todo\n---\n\n# A\n" },
      "args": { "path": "door-cases/a.md", "patch": { "status": "done" } },
      "records": { "kind": "vault.write", "path": "door-cases/a.md" }
    },
    {
      "door": "set_note_title",
      "seed": { "door-cases/a.md": "# A\n" },
      "args": { "path": "door-cases/a.md", "title": "Renamed" },
      "records": { "kind": "vault.write", "path": "door-cases/a.md" }
    },
    {
      "door": "set_note_title",
      "args": { "path": "knowledge/concepts/a.md", "title": "Renamed" },
      "refused": "read-only"
    },
    {
      "door": "create_note",
      "args": { "folder": "door-cases", "slug": "fresh", "frontmatter": {}, "body": "# Fresh\n" },
      "records": { "kind": "vault.create", "path": "door-cases/fresh.md" }
    },
    {
      "door": "create_note",
      "args": { "folder": "knowledge", "slug": "fresh", "frontmatter": {}, "body": "# Fresh\n" },
      "refused": "read-only"
    },
    {
      "door": "save_view",
      "args": { "id": "door-case", "yaml": "name: Door case\n", "folder": "door-cases" },
      "records": { "kind": "vault.create", "path": "door-cases/views/door-case.yml" }
    },
    {
      "door": "save_view",
      "args": { "id": "door-case", "yaml": "name: Door case\n", "folder": "knowledge" },
      "refused": "read-only",
