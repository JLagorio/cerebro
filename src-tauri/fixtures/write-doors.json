        ".trash/20261014T093000Z-a1b2/.trashed.json": "{\n  \"format\": 1,\n  \"path\": \"door-cases/a.md\",\n  \"kind\": \"file\",\n  \"title\": \"A\",\n  \"deleted_at\": \"2026-10-14T09:30:00Z\"\n}\n"
      },
      "args": { "stamp": "20261014T093000Z-a1b2" },
