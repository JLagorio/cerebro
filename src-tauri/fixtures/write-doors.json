    },
    {
      "door": "save_collection",
      "args": { "folder": "door-cases", "yaml": "name: Door cases\n" },
      "records": { "kind": "vault.create", "path": "door-cases/collection.yml" }
    },
    {
      "door": "save_collection",
      "args": { "folder": "knowledge", "yaml": "name: Bundle\n" },
      "refused": "read-only"
    },
    {
      "door": "save_list",
      "args": { "folder": "door-cases", "id": "backlog", "yaml": "name: Backlog\n" },
      "records": { "kind": "vault.create", "path": "door-cases/backlog.list.yml" }
    },
    {
      "door": "save_list",
      "args": { "folder": "knowledge", "id": "backlog", "yaml": "name: Backlog\n" },
      "refused": "read-only"
    },
    {
      "door": "create_folder",
      "args": { "path": "door-cases/empty" },
