      "records": { "kind": "vault.rename", "path": "door-cases/a.md", "to": "door-cases/b.md" }
    },
    {
      "door": "rename_note",
      "seed": { "door-cases/a.md": "# A\n" },
      "args": { "from": "door-cases/a.md", "to": "knowledge/a.md" },
      "refused": "read-only"
    },
    {
      "door": "delete_note",
      "args": { "path": "knowledge/concepts/a.md" },
