      "door": "restore_from_trash",
      "seed": {
        ".trash/20261014T093000Z-a1b2/knowledge/a.md": "# A\n",
        ".trash/20261014T093000Z-a1b2/.trashed.json": "{\n  \"format\": 1,\n  \"path\": \"knowledge/a.md\",\n  \"kind\": \"file\",\n  \"title\": \"A\",\n  \"deleted_at\": \"2026-10-14T09:30:00Z\"\n}\n"
      },
      "args": { "stamp": "20261014T093000Z-a1b2" },
      "refused": "read-only"
    },
    {
      "door": "write_text_file",
      "args": { "path": "door-cases/new.mmd", "content": "graph TD\n" },
      "records": { "kind": "vault.create", "path": "door-cases/new.mmd" }
    },
    {
      "door": "write_text_file",
      "args": { "path": "knowledge/new.mmd", "content": "graph TD\n" },
      "refused": "read-only"
    },
    {
      "door": "import_attachment",
      "args": { "source": "/SOURCE/door-case.pdf" },
      "records": { "kind": "vault.create", "path": "attachments/door-case.pdf" }
    },
    {
      "door": "verify_concept",
      "seed": { "door-cases/a.md": "# A\n" },
      "args": {
        "path": "door-cases/a.md",
        "patch": { "verified": { "by": "human:me", "at": "2026-10-14T09:00:00Z" } },
        "viewed_body_hash": ""
      },
      "refused": "verify_concept only applies to knowledge/ concepts"
    },
    {
      "door": "capture_concept_edit",
      "seed": { "door-cases/a.md": "# A\n" },
      "args": {
        "request": {
          "kind": "editorial",
          "path": "door-cases/a.md",
          "actor_id": "human:owner",
          "ops": [],
          "origin": "in_app",
          "request_id": "door-case"
        }
      },
      "refused": "capture applies only to knowledge/ projections"
    },
    {
      "door": "restore_note_version",
      "args": {
        "path": "knowledge/concepts/a.md",
        "commit": "0000000000000000000000000000000000000000"
      },
      "refused": "read-only",
      "why": "Restore is a person's write (M58.4): its receipt is minted from the bundle guard. Only the refusal replays: a restore that lands needs a repository."
    }
  ],
  "agent": [
    {
