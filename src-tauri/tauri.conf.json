{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cerebro",
  "version": "0.1.0",
  "identifier": "com.cerebro.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cerebro",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Files-first work management",
    "longDescription": "Projects, docs, and work items live in a folder of markdown files you own. The assistant is the Claude Code CLI already installed on your machine.",
    "copyright": "Copyright © 2026 Cerebro contributors",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../demo-vault": "demo-vault"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
